<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>SharePointExplorer.Recovery</AssemblyName>
    <RootNamespace>SharePointExplorer</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src\Core\**\*.cs;src\Storage\**\*.cs;src\Serialization\**\*.cs;src\Export\**\*.cs" />
    <EmbeddedResource Include="src\Export\Schemas\*.xsd" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
  </ItemGroup>
</Project>
