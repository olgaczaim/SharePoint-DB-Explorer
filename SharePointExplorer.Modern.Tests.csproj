<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>SharePointExplorer.Modern.Tests</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>annotations</Nullable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src\Core\**\*.cs;src\Storage\**\*.cs;src\Serialization\**\*.cs;src\Export\**\*.cs" />
    <Compile Include="src\Desktop\*.cs;src\Desktop\ViewModels\**\*.cs" />
    <Compile Include="tests\Modern\**\*.cs" />
    <Compile Include="tests\StorageFixture.cs;tests\RecoveryEngineChecks.cs;tests\DesktopExportChecks.cs;tests\SqlConnectionChecks.cs;tests\CatalogChecks.cs" />
    <EmbeddedResource Include="src\Export\Schemas\*.xsd" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
  </ItemGroup>
</Project>
