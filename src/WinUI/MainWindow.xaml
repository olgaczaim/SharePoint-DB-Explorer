<Window
    x:Class="SharePointExplorer.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SharePointExplorer.Desktop.ViewModels"
    xmlns:local="using:SharePointExplorer.WinUI"
    Title="SharePoint Database Explorer">
    <Grid x:Name="ShellGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Loaded="ShellLoaded">
<Grid.Resources>
            <local:NodeGlyphConverter x:Key="NodeGlyphConverter" />
            <local:BooleanVisibilityConverter x:Key="BooleanVisibilityConverter" />
        </Grid.Resources>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid x:Name="HeaderGrid" Grid.Row="0" Padding="28,22,28,16" ColumnSpacing="20">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Border Background="{ThemeResource AccentFillColorDefaultBrush}" Width="44" Height="44" CornerRadius="10" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE8F1;" FontSize="22" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock x:Name="HeaderTitleText" Text="SharePoint Database Explorer" TextWrapping="NoWrap" Style="{StaticResource TitleTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="HeaderSubtitleText" Text="Browse restored content and export the files you need." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Border x:Name="SourceBadge" Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16,10" MaxWidth="310" VerticalAlignment="Center">
                <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><FontIcon Glyph="&#xE968;" FontSize="16"/><TextBlock x:Name="SourceText" AutomationProperties.AutomationId="SourceText" Grid.Column="1" Text="No database connected" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" /></Grid>
            </Border>
        </Grid>
        <Grid x:Name="HeaderActions" Grid.Row="1" Padding="28,0,28,16" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Button x:Name="ConnectButton" AutomationProperties.AutomationId="ConnectButton" Click="ConnectClicked" AutomationProperties.Name="Connect to a content database">
                <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE710;" FontSize="14"/><TextBlock Text="Connect database"/></StackPanel>
            </Button>
            <Button x:Name="RefreshButton" AutomationProperties.AutomationId="RefreshButton" Grid.Column="1" Click="RefreshClicked" IsEnabled="False" AutomationProperties.Name="Refresh this location" ToolTipService.ToolTip="Refresh (F5)">
                <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72C;" FontSize="14"/><TextBlock Text="Refresh"/></StackPanel>
                <Button.KeyboardAccelerators><KeyboardAccelerator Key="F5" Invoked="RefreshAccelerator" /></Button.KeyboardAccelerators>
            </Button>
            <Button x:Name="UpButton" AutomationProperties.AutomationId="UpButton" Grid.Column="2" Click="UpClicked" IsEnabled="False" AutomationProperties.Name="Go up one level" ToolTipService.ToolTip="Up one level (Alt+Up)">
                <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE74A;" FontSize="14"/><TextBlock Text="Up one level"/></StackPanel>
                <Button.KeyboardAccelerators><KeyboardAccelerator Key="Up" Modifiers="Menu" Invoked="UpAccelerator" /></Button.KeyboardAccelerators>
            </Button>
            <StackPanel x:Name="NavigationHint" Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" VerticalAlignment="Center">
                <ProgressRing x:Name="LoadingRing" Width="18" Height="18" IsActive="False" Visibility="Collapsed" />
                <TextBlock Text="Selections apply to the current folder." Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>
        </Grid>
        <Grid x:Name="ExplorerLayout" Grid.Row="2" ColumnSpacing="16" Margin="20,0,20,16" SizeChanged="ExplorerLayoutSizeChanged">
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="NavigationColumn" Width="270"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="12,16,8,8">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="Sites and libraries" FontWeight="SemiBold" Margin="8,0,0,12" />
                    <TreeView x:Name="ExplorerTree" AutomationProperties.AutomationId="ExplorerTree" Grid.Row="1" SelectionMode="Single" CanDragItems="False" CanReorderItems="False" AllowDrop="False" Expanding="TreeExpanding" ItemInvoked="TreeItemInvoked" SelectionChanged="TreeSelectionChanged" AutomationProperties.Name="Sites, libraries, lists and folders">
                        <TreeView.ItemTemplate><DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="10" AutomationProperties.Name="{Binding Content.Name}">
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="{Binding Content.IconKey, Converter={StaticResource NodeGlyphConverter}}" FontSize="16" />
                                <TextBlock Text="{Binding Content.Name}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate></TreeView.ItemTemplate>
                    </TreeView>
                </Grid>
            </Border>
            <Border x:Name="ContentCard" Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="22,18">
                <Grid x:Name="ContentGrid" RowSpacing="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Spacing="5">
                            <TextBlock x:Name="LocationText" AutomationProperties.AutomationId="LocationText" Text="Your SharePoint content" Style="{StaticResource SubtitleTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="BreadcrumbText" AutomationProperties.AutomationId="BreadcrumbText" Text="Connect a restored content database to get started." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button x:Name="VersionHistoryButton" AutomationProperties.AutomationId="VersionHistoryButton" Content="Versions" Click="VersionHistoryClicked" IsEnabled="False" AutomationProperties.Name="Browse selected document version history" ToolTipService.ToolTip="Select a document row to browse and export its versions" />
                            <Button x:Name="MoreExportsButton" AutomationProperties.AutomationId="MoreExportsButton" Content="More" IsEnabled="False" AutomationProperties.Name="More export options">
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem x:Name="SaveLibraryZipMenu" Text="Save entire library as ZIP" Click="SaveLibraryZipClicked" IsEnabled="False" AutomationProperties.AutomationId="SaveLibraryZipMenu" />
                                        <MenuFlyoutItem x:Name="SaveFolderZipMenu" Text="Save this folder as ZIP" Click="SaveFolderZipClicked" IsEnabled="False" AutomationProperties.AutomationId="SaveFolderZipMenu" />
                                        <MenuFlyoutItem x:Name="ExportVersionsMenu" Text="Export all versions of checked files" Click="ExportVersionsClicked" IsEnabled="False" AutomationProperties.AutomationId="ExportVersionsMenu" />
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem x:Name="ExportDeletedItemMenu" Text="Recover deleted list item metadata" Click="ExportDeletedItemClicked" IsEnabled="False" AutomationProperties.AutomationId="ExportDeletedItemMenu" />
                                        <MenuFlyoutItem x:Name="ExportItemAttachmentsMenu" Text="Export item attachments" Click="ExportItemAttachmentsClicked" IsEnabled="False" AutomationProperties.AutomationId="ExportItemAttachmentsMenu" />
                                        <MenuFlyoutItem x:Name="ExportListAttachmentsMenu" Text="Export list attachments" Click="ExportListAttachmentsClicked" IsEnabled="False" AutomationProperties.AutomationId="ExportListAttachmentsMenu" />
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem x:Name="ExportPackageMenu" Text="Export XML package" Click="ExportPackageClicked" IsEnabled="False" AutomationProperties.AutomationId="ExportPackageMenu" />
                                        <MenuFlyoutItem x:Name="ExportHistoryPackageMenu" Text="Export XML package with version history" Click="ExportHistoryPackageClicked" IsEnabled="False" AutomationProperties.AutomationId="ExportHistoryPackageMenu" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <Grid x:Name="SelectionToolbar" Grid.Row="1" ColumnSpacing="8" RowSpacing="8">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Button x:Name="SelectAllButton" AutomationProperties.AutomationId="SelectAllButton" Content="Select all files" Click="SelectAllClicked" IsEnabled="False" AutomationProperties.Name="Select all files in this folder" />
                        <Button x:Name="ClearSelectionButton" AutomationProperties.AutomationId="ClearSelectionButton" Grid.Column="1" Content="Clear selection" Click="ClearSelectionClicked" IsEnabled="False" AutomationProperties.Name="Clear selected files" />
                        <Grid x:Name="SelectedExportActions" Grid.Column="2" Grid.ColumnSpan="2" ColumnSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="SelectionCountText" AutomationProperties.AutomationId="SelectionCountText" Text="0 files selected" Margin="6,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Button x:Name="SaveZipButton" AutomationProperties.AutomationId="SaveZipButton" Grid.Column="1" Content="Save ZIP" Click="SaveZipClicked" IsEnabled="False" AutomationProperties.Name="Save checked files as a ZIP archive" ToolTipService.ToolTip="Save the checked files in this folder as one ZIP archive" />
                            <Button x:Name="ExportButton" AutomationProperties.AutomationId="ExportButton" Grid.Column="2" Content="Export selected" Style="{StaticResource AccentButtonStyle}" Click="ExportClicked" IsEnabled="False" AutomationProperties.Name="Export selected files" />
                        </Grid>
                        <Button x:Name="ExportLibraryButton" AutomationProperties.AutomationId="ExportLibraryButton" Grid.Row="1" Grid.ColumnSpan="2" Content="Export library" HorizontalAlignment="Left" Click="ExportLibraryClicked" IsEnabled="False" AutomationProperties.Name="Export the entire document library including all folders" />
                        <TextBlock x:Name="LibraryExportHint" Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Text="Open a library to export all its files." Margin="6,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                    <InfoBar x:Name="ErrorInfoBar" AutomationProperties.AutomationId="ErrorInfoBar" Grid.Row="2" Severity="Error" IsOpen="False" IsClosable="True" Title="An operation needs attention" />
                    <ScrollViewer x:Name="TableScrollViewer" Grid.Row="3" Grid.RowSpan="2" HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled">
                        <Grid MinWidth="800" RowSpacing="8">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Grid.Row="0" Padding="10,8" ColumnSpacing="12" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="80"/><ColumnDefinition Width="140"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="2" Text="Name" Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBlock Grid.Column="3" Text="Type" Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBlock Grid.Column="4" Text="Size" Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBlock Grid.Column="5" Text="Modified" Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBlock Grid.Column="6" Text="Status" Style="{StaticResource CaptionTextBlockStyle}" />
                    </Grid>
                    <Grid Grid.Row="1">
                        <ListView x:Name="ItemsList" AutomationProperties.AutomationId="ItemsList" SelectionMode="Single" IsItemClickEnabled="False" ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled" DoubleTapped="ItemsDoubleTapped" SelectionChanged="ItemsSelectionChanged" KeyDown="ItemsKeyDown" ContainerContentChanging="ItemsContainerChanging" AutomationProperties.Name="Content of the current folder">
                            <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="MinHeight" Value="48"/><Setter Property="Padding" Value="10,4"/></Style></ListView.ItemContainerStyle>
                            <ListView.ItemTemplate><DataTemplate x:DataType="vm:ItemViewModel">
                                <Grid ColumnSpacing="12" ToolTipService.ToolTip="{x:Bind Path}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="80"/><ColumnDefinition Width="140"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" IsChecked="{x:Bind IsChecked, Mode=TwoWay}" Visibility="{Binding CanCheck, Converter={StaticResource BooleanVisibilityConverter}}" IsEnabled="{x:Bind CanCheck}" Checked="FileCheckChanged" Unchecked="FileCheckChanged" DoubleTapped="FileCheckDoubleTapped" AutomationProperties.Name="{x:Bind Name}" MinWidth="32" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                    <FontIcon Grid.Column="1" FontFamily="Segoe MDL2 Assets" Glyph="{Binding IconKey, Converter={StaticResource NodeGlyphConverter}}" FontSize="18" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind KindText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="4" Text="{x:Bind SizeText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="5" Text="{x:Bind ModifiedText}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="6" Text="{x:Bind ExportStatus, Mode=OneWay}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </DataTemplate></ListView.ItemTemplate>
                        </ListView>
                        <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Margin="24" IsHitTestVisible="False">
                            <FontIcon Glyph="&#xE8F1;" FontSize="32" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="EmptyStateText" Text="Connect a database to browse its content." TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
        <Border x:Name="StatusBorder" Grid.Row="3" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="28,12">
            <TextBlock x:Name="StatusText" AutomationProperties.AutomationId="StatusText" Text="Ready to connect" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite" />
        </Border>
    </Grid>
</Window>








