<?xml version="1.0" encoding="utf-8"?>
<!--
Self-contained x64 publish of the desktop app. The Visual Studio Installer
project packages this profile's "Publish Items": the executable, the .NET
runtime, the Windows App SDK runtime and every resource subfolder.
-->
<Project>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'SharePointExplorer.Desktop'">
    <Configuration>Release</Configuration>
    <Platform>x64</Platform>
    <PublishProtocol>FileSystem</PublishProtocol>
    <PublishDir>bin\Installer\</PublishDir>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
</Project>
